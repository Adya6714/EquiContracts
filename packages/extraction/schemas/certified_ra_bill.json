{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "certified_ra_bill",
  "description": "Extraction schema for certified running account bills (post-client/PMC certification).",
  "type": "object",
  "properties": {
    "ra_bill_number": {
      "type": ["string", "null"],
      "description": "RA bill number as certified"
    },
    "work_order_ref": {
      "type": ["string", "null"]
    },
    "certified_amount": {
      "type": ["string", "null"],
      "description": "Amount certified by client/PMC as decimal string",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "gross_claimed_amount": {
      "type": ["string", "null"],
      "description": "Original amount claimed by contractor",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "certification_date": {
      "type": ["string", "null"],
      "format": "date"
    },
    "certification_date_raw": {
      "type": ["string", "null"]
    },
    "certifying_authority": {
      "type": ["string", "null"],
      "description": "Name or role of person/org who certified"
    },
    "deductions": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": ["tds", "wct", "retention", "advance", "cement_recovery", "debris", "other"]
          },
          "amount": {
            "type": "string",
            "pattern": "^\\d+\\.\\d{2}$"
          },
          "description": {
            "type": ["string", "null"]
          }
        },
        "required": ["category", "amount"]
      }
    },
    "net_payable": {
      "type": ["string", "null"],
      "description": "Amount after all deductions",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "seller_gstin": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$"
    },
    "buyer_gstin": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$"
    },
    "cgst": {
      "type": ["string", "null"],
      "description": "Central GST amount. Null if inter-state (IGST applies instead).",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "sgst": {
      "type": ["string", "null"],
      "description": "State GST amount. Null if inter-state.",
      "pattern": "^\\d+\\.\\d{2}$"
    },
    "igst": {
      "type": ["string", "null"],
      "description": "Integrated GST. Null if intra-state (CGST+SGST apply). NEVER 0.00 for absent.",
      "pattern": "^\\d+\\.\\d{2}$"
    }
  },
  "required": ["ra_bill_number", "certified_amount"],
  "additionalProperties": false
}
