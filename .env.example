# EquiContracts — Environment Variables
# Copy to .env and fill in values. Never commit .env itself.

# Postgres
DATABASE_URL=postgresql+psycopg://equicontracts_app:localdev@localhost:5432/equicontracts
ADMIN_DATABASE_URL=postgresql+psycopg://postgres:localdev@localhost:5432/equicontracts
POSTGRES_PASSWORD=localdev
APP_DATABASE_PASSWORD=localdev
SYSTEM_DATABASE_PASSWORD=localdev
SYSTEM_DATABASE_URL=postgresql+psycopg://equicontracts_system:localdev@localhost:5432/equicontracts
AGENT_DATABASE_PASSWORD=localdev
AGENT_DATABASE_URL=postgresql+psycopg://equicontracts_agent:localdev@localhost:5432/equicontracts

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=equicontracts-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Inbound email provider (Postmark or SendGrid)
# One shared mailbox; projects route via projects+{alias}@domain.
INBOUND_EMAIL_HMAC_SECRET=change-me-in-production
INBOUND_MAILBOX=projects
INBOUND_EMAIL_DOMAIN=equicontracts.local

# Auth (Phase 0 uses header stub; replaced in Phase 1)
AUTH_MODE=dev_header

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# Private evaluation source bucket (raw documents never enter git)
EVAL_BUCKET=
EVAL_PREFIX=eval-set-v0

# LLM / extraction (Phase 1)
# Suggested: LLM_PROVIDER=gemini
# Suggested: LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL overrides the fixed default for the chosen provider when set.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
